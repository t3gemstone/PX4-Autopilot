CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-r5f"

# --- First bring-up: minimal "does it boot + uORB alive" set ---------------
# Flight-stack modules (commander, ekf2, mavlink, ...) are intentionally left
# out until the platform is proven. The ICM-20948 IMU is enabled now that the
# AM67 SPI arch-support layer (px4_spibus + hardware-CS glue) exists
# (platforms/nuttx/src/px4/ti/am67/spi); it is started from
# init/rc.board_sensors.

CONFIG_DRIVERS_IMU_INVENSENSE_ICM20948=y
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y

CONFIG_SYSTEMCMDS_ACTUATOR_TEST=y
CONFIG_SYSTEMCMDS_I2CDETECT=y
CONFIG_SYSTEMCMDS_I2CREAD=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
# CONFIG_SYSTEMCMDS_REBOOT needs NuttX CONFIG_BOARDCTL_RESET (arch must select
# ARCH_HAVE_RESET) to expose px4_reboot_request(). Re-enable once wired.
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_TOPIC_LISTENER=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y
