#!/bin/sh
#
# T3 Gemstone O1 (AM67 / J722S) board-specific defaults.
#------------------------------------------------------------------------------

# No ADC / system-power sensing on this board yet -> skip the supply check so
# the commander does not refuse to arm on a missing power brick.
param set-default CBRK_SUPPLY_CHK 894281

# The IMU is an ICM-20948 (9-axis, integrated AK09916 magnetometer).
param set-default SYS_HAS_MAG 1

# NOTE: the PWM output function map (PWM_MAIN_FUNC1..5 = Motor1..5) is set in
# src/init.c board_app_initialize() via param_set_default_value(), NOT here -
# this board does not build CONFIG_NSH_ROMFSETC so rcS/rc.board_defaults never
# auto-runs.
